{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Fluvius CSV",
      "detail": "Regenerate the sanitized grid supplement when the newest private CSV changes.",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/watch-grid-supplement.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}